# SABOR BRAVO — variables de entorno. Copia este archivo a `.env.local` (NO se sube a git) y rellénalo.
# Las claves reales y las URLs de producción NUNCA van aquí ni al repositorio.

# Base de datos PostgreSQL.
#  · Desarrollo local: arranca una base embebida con `npm run db:dev` y usa esta URL tal cual.
#  · Producción (Supabase): "Project Settings → Database → Connection string → Transaction pooler" (puerto 6543),
#    y configúrala SOLO como variable de entorno del hosting (Netlify), nunca en este archivo.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/sabor

# URL pública del sitio, usada para los códigos QR (sin barra final). Si falta, se usa el dominio de la petición.
# En producción: https://sabor-bravo.netlify.app (o tu dominio propio).
SITE_URL=http://localhost:3000

# Acceso con Google (OpenID Connect). Sin estas dos variables el botón «Continuar con Google» responde «aún no disponible».
# Se crean en Google Cloud Console → APIs y servicios → Credenciales → ID de cliente de OAuth (aplicación web).
# URI de redirección autorizadas: http://localhost:3000/auth/google/callback y https://sabor-bravo.netlify.app/auth/google/callback
# El secreto NUNCA va a git ni al navegador: solo a .env.local y a las variables de entorno de Netlify (marcado como secreto).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
